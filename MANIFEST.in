# MANIFEST.in

global-exclude .gitkeep

prune .git
prune .idea
prune .ipynb_checkpoints
prune __pycache__
prune input
prune output
prune parameter

recursive-include examples/data/Testkistan *
include config/default.yaml
include config/user_defined_Testkistan.yaml
include output/README.md
include tmp/README.md
